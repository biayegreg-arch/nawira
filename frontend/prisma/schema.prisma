generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore). DELETED = terminal,
  // set only by self-service DELETE /api/account (lib/server/account/
  // delete-account.ts) — no route re-checks this value because deletion
  // already scrambles `email` (breaks login lookup) and bumps `tokenVersion`
  // (invalidates every refresh token), so login/refresh are unreachable for
  // a DELETED row without a separate status branch.
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes      VerificationCode[]
  uploads                FileUpload[]
  notifications          Notification[]
  notifPrefs             NotificationPreferences?
  profile                Profile?
  consents               Consent[]
  periodEvents           PeriodEvent[]
  cycles                 Cycle[]
  dailyLogs              DailyLog[]
  fertilitySignals       FertilitySignal[]
  prediction             Prediction?
  insights               Insight[]
  oauthAccounts          OAuthAccount[]
  adminActions           AdminAction[]
  assistantConversations AssistantConversation[]
  accountActivity        AccountActivity[]
  analyticsEvents        AnalyticsEvent[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "user.suspend", "user.role_change", "user.delete").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron modeled on the other
// purge crons under frontend/src/app/api/cron/.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// User-facing account-security activity log (E8 part A). Distinct from
// AdminAction above: this is "what happened to MY account" (login,
// password change, OAuth link, data export), shown on the user's own
// /settings privacy page — not an admin/back-office audit trail.
// ───────────────────────────────────────────────────────────────────────
model AccountActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // LOGIN | PASSWORD_CHANGED | PASSWORD_SET | OAUTH_LINKED | DATA_EXPORTED | ACCOUNT_DELETED
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PricingPlan {
  id        String   @id @default(cuid())
  key       String   @unique // "PLUS" | "BABY" — FREE has no row (always 0 FCFA)
  priceFcfa Int // integer FCFA, no decimals (CLAUDE.md money invariant)
  updatedAt DateTime @updatedAt
  updatedBy String? // User.id of the admin who last changed it (denormalized
  // convenience; the authoritative trail is AdminAction)
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (e.g. `Cycle.userId`, `Profile.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// NAWIRA Phase 1 — cycle-tracking domain models.
// See docs/superpowers/specs/2026-09-06-phase1-data-model-design.md for
// the full rationale (PRD section references, why Cycle/Prediction are
// materialized rather than computed on read, why enums are plain String
// columns matching the rest of this schema).
// ───────────────────────────────────────────────────────────────────────

model Profile {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate         DateTime
  goal              String // PERIOD_TRACKING | UNDERSTAND_CYCLE | TRYING_TO_CONCEIVE
  usualCycleLength  Int?
  usualPeriodLength Int?
  trackedConcerns   String[]  @default([])
  plan              String    @default("FREE") // FREE | PLUS | BABY
  planExpiresAt     DateTime? // null = permanent; set only via admin grant with an end date;
  // cleared automatically by the plan-expiration cron on downgrade
  temperatureUnit   String    @default("CELSIUS") // CELSIUS | FAHRENHEIT
  notificationLevel String    @default("NORMAL") // NORMAL | DISCREET | NONE
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Consent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // ACCOUNT | HEALTH_DATA | ASSISTANT_HISTORY | NOTIFICATIONS | ANALYTICS | MARKETING
  version   Int
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId, type])
}

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String? // derived from the first user message, truncated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AssistantMessage[]

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // USER | ASSISTANT
  content        String                @db.Text
  // Set only on USER messages, and only when the conversation is persisted
  // (ASSISTANT_HISTORY consent granted) — stored for a future E12 analytics
  // pass (spec §9); no event pipeline exists yet.
  intentCategory String?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

model PeriodEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  flow      String // SPOTTING | LIGHT | MEDIUM | HEAVY
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, date])
}

model Cycle {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  length    Int?
  isOutlier Boolean   @default(false)

  @@unique([userId, startDate])
}

model DailyLog {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime     @db.Date
  painLevel    Int?
  painLocation String?
  mood         String? // VERY_GOOD | GOOD | TIRED | STRESSED | LOW
  energy       String? // VERY_LOW | LOW | MEDIUM | HIGH | VERY_HIGH
  sleepQuality String? // POOR | FAIR | GOOD | EXCELLENT
  sleepHours   Float?
  note         String?
  symptoms     SymptomLog[]
  updatedAt    DateTime     @default(now()) @updatedAt

  @@unique([userId, date])
}

model SymptomLog {
  id         String   @id @default(cuid())
  dailyLogId String
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  symptom    String // CRAMPS | HEADACHE | BLOATING | NAUSEA | ACNE | TENDER_BREASTS | FATIGUE | BACK_PAIN | CONSTIPATION | DIARRHEA | FOOD_CRAVINGS | LIBIDO_CHANGE

  @@unique([dailyLogId, symptom])
}

model FertilitySignal {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  type              String // BASAL_TEMPERATURE | CERVICAL_MUCUS | LH_TEST
  temperatureValue  Float?
  temperatureUnit   String? // CELSIUS | FAHRENHEIT
  cervicalMucusType String? // DRY | STICKY | CREAMY | WATERY | EGG_WHITE
  lhResult          String? // NEGATIVE | POSITIVE | PEAK | INCONCLUSIVE
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([userId, date, type])
}

model Prediction {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  algorithmVersion    String
  confidence          String // LOW | MEDIUM | HIGH
  expectedPeriodStart DateTime
  expectedPeriodEnd   DateTime
  ovulationEstimate   DateTime?
  fertileWindowStart  DateTime?
  fertileWindowEnd    DateTime?
  computedAt          DateTime
  version             Int       @default(0)
}

model Insight {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String // e.g. CYCLE_SCORE | SYMPTOM_TREND
  payload          Json
  periodAnalyzed   Json
  cyclesConsidered Int
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Privacy-safe product analytics (PRD E12, §16 + §28.13). `type` is one of
// a fixed allowlist enforced server-side (frontend/src/lib/server/analytics/
// schemas.ts) — never free text, symptoms, period dates, or fertility/
// pregnancy status. Most event types require a live Consent{type:
// ANALYTICS} row; onboarding_started/goal_selected are the sole exemption
// (see the E12-foundations design spec).
// ───────────────────────────────────────────────────────────────────────
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  properties Json
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
}
